# Solo para desarrollo y pruebas
ALLOW_ALL_HOSTS=true

# No se requiere mientras ALLOW_ALL_HOSTS sea true
ALLOWED_HOSTS=

# Ajustar al destino real del backend
API_PROXY_TARGET=http://localhost:8081

VITE_API_URL=
VITE_API_PROXY_TARGET=

# Modo offline: usa el mapa completo (login, Disenador, Monitoreo) sin backend,
# para pruebas internas o revisar cambios. Ver PLAN_MAPA_COMPLETO.md, seccion 0.
# Credencial de prueba: offline@recolecta.local / offline123
VITE_OFFLINE_MODE=false

# EXPERIMENTAL (Fase 12): intento de sync contra un endpoint sin confirmar.
# Ver .env.example para el detalle. Dejar en false.
VITE_SYNC_PUNTOS_ENABLED=false

# Copia este archivo como .env o usa .env.development para desarrollo.
#
# Desarrollo y pruebas:
# - permite entrar desde cualquier host temporal, incluyendo ngrok-free.app,
#   ngrok-free.dev u otros dominios temporales.
#
# Produccion:
# - cambia ALLOW_ALL_HOSTS a false.
# - define ALLOWED_HOSTS con dominios reales separados por comas.
# - no uses protocolo, rutas ni diagonales finales.
#   Correcto: frontend.example.com,www.example.com
#   Incorrecto: https://frontend.example.com/,https://example.com/login

# true unicamente para desarrollo y pruebas
ALLOW_ALL_HOSTS=true

# Hosts separados por comas y sin protocolo
ALLOWED_HOSTS=

# Destino interno o externo del backend
API_PROXY_TARGET=http://localhost:8081

# Compatibilidad con la configuracion anterior
VITE_API_URL=
VITE_API_PROXY_TARGET=

# Solo local (sin tunel):
# API_PROXY_TARGET=http://localhost:8081

# Si usas ngrok, pon la URL del tunel aqui y deja VITE_API_URL vacio.
# API_PROXY_TARGET=https://TU-SUBDOMINIO.ngrok-free.app

# Llamada directa (requiere CORS en Gin; no usar ngrok aqui):
# VITE_API_URL=http://localhost:8081

# Ejemplo de produccion:
# ALLOW_ALL_HOSTS=false
# ALLOWED_HOSTS=frontend.example.com,www.example.com
# API_PROXY_TARGET=http://localhost:8081

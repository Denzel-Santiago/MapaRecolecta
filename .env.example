# Desarrollo local sin proxy: apunta directo a Gin (Docker BACKEND_PORT=8081).
# Requiere CORS con http://localhost:5173 en recolecta_web/.env
VITE_API_URL=http://localhost:8081

# Alternativa con proxy Vite (deja VITE_API_URL vacio):
# VITE_API_URL=
# VITE_API_PROXY_TARGET=http://localhost:8081

# Evita usar ngrok en VITE_API_URL desde el navegador (CORS / interstitial).

# Copia este archivo como .env o usa .env.development para desarrollo.
#
# Desarrollo y pruebas:
# - permite entrar desde cualquier host temporal, incluyendo ngrok-free.app,
#   ngrok-free.dev u otros dominios temporales.
#
# Produccion:
# - cambia ALLOW_ALL_HOSTS a false.
# - define ALLOWED_HOSTS con dominios reales separados por comas.
# - no uses protocolo, rutas ni diagonales finales.
#   Correcto: frontend.example.com,www.example.com
#   Incorrecto: https://frontend.example.com/,https://example.com/login

# true unicamente para desarrollo y pruebas
ALLOW_ALL_HOSTS=true

# Hosts separados por comas y sin protocolo
ALLOWED_HOSTS=

# Destino interno o externo del backend
API_PROXY_TARGET=http://localhost:8081

# Compatibilidad con la configuracion anterior
VITE_API_URL=
VITE_API_PROXY_TARGET=

# Motor de rutas compatible con OSRM. Si no responde o no hay internet, el
# frontend usa el callejero local minimo solo para pruebas offline.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_OSRM_PROFILE=driving

# Solo local (sin tunel):
# API_PROXY_TARGET=http://localhost:8081

# Si usas ngrok, pon la URL del tunel aqui y deja VITE_API_URL vacio.
# API_PROXY_TARGET=https://TU-SUBDOMINIO.ngrok-free.app

# Llamada directa (requiere CORS en Gin; no usar ngrok aqui):
# VITE_API_URL=http://localhost:8081

# Ejemplo de produccion:
# ALLOW_ALL_HOSTS=false
# ALLOWED_HOSTS=frontend.example.com,www.example.com
# API_PROXY_TARGET=http://localhost:8081

# Modo offline: usa el mapa completo (login, Disenador, Monitoreo) sin backend,
# para pruebas internas o revisar cambios. Apagado por defecto; no usar en produccion.
# Credencial de prueba mientras esta activo: offline@recolecta.local / offline123
# Ver PLAN_MAPA_COMPLETO.md, seccion 0.
VITE_OFFLINE_MODE=false

# EXPERIMENTAL (Fase 12, PLAN_MAPA_COMPLETO.md): intenta sincronizar los
# puntos del borrador contra POST /api/puntos-recoleccion/sync justo despues
# de guardar la ruta, ademas del guardado normal (que no cambia). El contrato
# de ese endpoint NO esta confirmado con backend (seccion 5.4/10 del plan):
# si el endpoint no existe o responde distinto a lo esperado, el intento de
# sync falla en silencio (solo se ve un aviso no bloqueante) y el guardado
# normal ya se completo de todas formas. Dejar en false hasta confirmar el
# contrato real.
VITE_SYNC_PUNTOS_ENABLED=false
